#!/usr/bin/env python3
"""
claude-sessions — Browse, resume & manage every Claude Code session on this machine.

Scans ~/.claude/projects/<encoded-cwd>/<uuid>.jsonl (the resumable "main" sessions,
not sidechain/subagent internals), extracts metadata, and (by default) serves a live
local dashboard in your browser. Because it's served over http://127.0.0.1, the in-page
Refresh, Rename and Delete are genuine one-click actions — no copy-a-command dance.

Each session shows: title (your /rename name, else the AI title, else first prompt),
project directory + git branch, last-activity date (relative + absolute), how many days
old, session duration, active working time, and its full prompt history.

Click any card (or its Resume button) to copy the exact command to resume it, e.g.
  cd /path/to/project && claude --resume "my-name"
which fixes the "no session named X" problem when resuming from another directory.

Usage:
    claude-sessions                 # serve the live dashboard and open it (default)
    claude-sessions --port 7842     # serve on a preferred localhost port
    claude-sessions --all           # also include SDK/agent-spawned sessions
    claude-sessions --no-open       # serve, but don't open the browser
    claude-sessions --static        # write a portable, self-contained static HTML file
    claude-sessions --static --out ~/Desktop/sessions.html
    claude-sessions --json          # dump raw session metadata as JSON
    claude-sessions --rename ID_OR_NAME "New name"
    claude-sessions --delete ID_OR_NAME [ID_OR_NAME ...]

Stdlib only. The server binds 127.0.0.1 (loopback) and never talks to the network.
"""
from __future__ import annotations

import argparse
import base64
