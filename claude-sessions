/* ---- in-conversation search: highlight matches, navigate with ↑/↓ or Enter ---- */
let convMarks=[], convIdx=-1, convT=null;
function convResetSearch(){
  convMarks=[]; convIdx=-1;
  const c=$('#convCount'); if(c) c.textContent='';
  const pv=$('#convPrev'), nx=$('#convNext'); if(pv) pv.disabled=true; if(nx) nx.disabled=true;
}
function convClearMarks(){
  const b=$('#modalBody');
  b.querySelectorAll('mark.hl').forEach(m=>{ m.parentNode.replaceChild(document.createTextNode(m.textContent), m); });
  b.normalize();
}
function convUpdateCount(){
  const c=$('#convCount'); if(!c) return;
  c.textContent = convMarks.length ? `${convIdx+1}/${convMarks.length}` : ($('#convSearch').value.trim() ? '0/0' : '');
  const dis=convMarks.length===0; $('#convPrev').disabled=dis; $('#convNext').disabled=dis;
}
function convFocusMark(){
  convMarks.forEach((m,i)=>m.classList.toggle('hl-current', i===convIdx));
  const m=convMarks[convIdx]; if(!m) return;
  const tool=m.closest('.turn.tool'); if(tool) tool.classList.remove('collapsed');  // reveal matches inside collapsed tool rows
  m.scrollIntoView({block:'center', behavior:'smooth'});
}
function convNav(d){ if(!convMarks.length) return; convIdx=(convIdx+d+convMarks.length)%convMarks.length; convFocusMark(); convUpdateCount(); }
function convRunSearch(){
  const q=$('#convSearch').value.trim();
  convClearMarks(); convMarks=[]; convIdx=-1;
  if(q){
    const root=$('#modalBody'), ql=q.toLowerCase();
    const walker=document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(n){ return (n.nodeValue && n.nodeValue.toLowerCase().includes(ql)) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT; }
    });
    const nodes=[]; let nd; while((nd=walker.nextNode())) nodes.push(nd);
    nodes.forEach(node=>{
      const text=node.nodeValue, lower=text.toLowerCase(); let from=0, idx; const frag=document.createDocumentFragment();
      while((idx=lower.indexOf(ql, from))!==-1){
        if(idx>from) frag.appendChild(document.createTextNode(text.slice(from,idx)));
