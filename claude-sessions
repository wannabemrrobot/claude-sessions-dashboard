async function doBulkDelete(){
  const ids=[...SELECTED];
  if(!ids.length) return;
  DELETING=true;
  const btn=$('#selConfirmDel');
  if(btn){ btn.disabled=true; btn.innerHTML=`<span class="btn-spin"></span>Deleting ${ids.length}…`; const c=$('#selCancelDel'); if(c) c.disabled=true; }
  ids.forEach(id=>setCardBusy(cardById(id),true));
  try{
    const j=await apiPost('/api/delete',{ids});
    const delCount=(j.deleted||[]).length, refused=(j.refused||[]).length;
    DELETING=false;
    SELECT_MODE=false; SELECTED.clear(); SELBAR_CONFIRM=false;
    document.body.classList.remove('selecting');
    const tb=$('#selectToggle'); if(tb){ tb.classList.remove('active'); const l=tb.querySelector('.lbl'); if(l) l.textContent='Select'; }
    $('#selbar').hidden=true;
    applyData(j);
    if(refused) showToast(IC.warn,`Deleted ${delCount} · skipped ${refused} running`,'warn');
    else showToast(IC.check,`Deleted ${delCount} session${delCount===1?'':'s'}`,'ok');
  }catch(e){
    DELETING=false;
    ids.forEach(id=>setCardBusy(cardById(id),false));
    showToast(IC.warn,'Delete failed: '+e.message,'warn');
    SELBAR_CONFIRM=false; renderSelBar();
  }
}
