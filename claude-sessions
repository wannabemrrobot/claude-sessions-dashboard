/* live "running" indicator: poll the cheap /api/active endpoint and toggle a badge/bar */
function applyActive(){
  document.querySelectorAll('#grid .card').forEach(c=>{
    const on=ACTIVE.has(c.dataset.id);
    c.classList.toggle('live', on);
    const del=c.querySelector('.act.delete');
    if(del){ del.disabled=on; del.setAttribute('data-tip', on?"Can't delete a running session":"Delete this session permanently"); }
  });
