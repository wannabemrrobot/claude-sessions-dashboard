from datetime import datetime, timedelta, timezone

DEFAULT_ROOT = os.path.expanduser("~/.claude/projects")

# Per-prompt character cap when embedding full prompt history (keeps the HTML bounded
# even when a session contains a huge pasted blob). Oversized prompts get a marker.
PROMPT_CAP = 6000

# Pasted images are base64-inline in the JSONL and can total tens of MB, so we can't
# embed them in the HTML. They are extracted to this sidecar folder (next to the output
# HTML) and referenced by relative path, lazily loaded by the browser.
ASSETS_DIRNAME = "claude-sessions-assets"
_EXT_BY_MEDIA = {
    "image/png": "png", "image/jpeg": "jpg", "image/jpg": "jpg",
    "image/gif": "gif", "image/webp": "webp", "image/svg+xml": "svg",
    "image/bmp": "bmp",
}


def parse_ts(ts):
    """Parse an ISO-8601 timestamp to an aware datetime (assume UTC if naive), or None."""
    if not ts or not isinstance(ts, str):
        return None
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None
    if dt.tzinfo is None:  # some rows omit the trailing Z / offset -> treat as UTC
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def extract_text(message):
    """Pull plain user text out of a message value that may be a str or block list."""
    if isinstance(message, str):
        return message
    if isinstance(message, dict):
        content = message.get("content")
        if isinstance(content, str):
            return content
        if isinstance(content, list):
            parts = []
            for block in content:
                if isinstance(block, dict) and block.get("type") == "text":
                    parts.append(block.get("text", ""))
                elif isinstance(block, str):
                    parts.append(block)
            return "\n".join(p for p in parts if p)
    return ""


# Claude Code logs each pasted image as TWO user rows:
#   1. the real message: "[Image #N] <your text>" + the inline base64 image (renders fine)
#   2. a companion bookkeeping row: "[Image: source: /tmp/.../N.png]" pointing at a
#      transient cache file that gets cleaned up. This companion carries NO image data and
#      duplicates the real row, so we strip it silently — the image already renders inline.
# Separately, some older sessions logged ONLY "[Image: original WxH, displayed at ...]" with
# no inline data anywhere: those images are genuinely gone, so we mark them "not stored".
_IMG_SRC_RE = re.compile(r"\[Image:\s*source:\s*[^\]]+\]")
_IMG_DIM_RE = re.compile(r"\[Image:\s*(original[^\]]*)\]")


def process_image_annotations(text):
    """Strip [Image: ...] text annotations, returning (clean_text, notes).

    'source:' companion refs are removed silently (the real image is inline in a sibling
    row). 'original WxH' annotations become notes -> 'image not stored' placeholders.
    """
    notes = []

    def repl_dim(m):
        mm = re.search(r"original\s+(\d+)x(\d+)", m.group(1))
        notes.append(f"{mm.group(1)}×{mm.group(2)}" if mm else "pasted image")
        return ""

    cleaned = _IMG_SRC_RE.sub("", text)      # drop companion bookkeeping rows
    cleaned = _IMG_DIM_RE.sub(repl_dim, cleaned)
    return cleaned.strip(), notes


def extract_images(message):
    """Return [{media_type, data(base64)}] for base64 image blocks in a user message."""
    out = []
    if isinstance(message, dict):
        content = message.get("content")
        if isinstance(content, list):
            for block in content:
                if isinstance(block, dict) and block.get("type") == "image":
                    src = block.get("source")
                    if isinstance(src, dict) and src.get("type") == "base64" and src.get("data"):
                        out.append({
                            "media_type": src.get("media_type", "image/png"),
                            "data": src["data"],
                        })
    return out


def looks_like_real_prompt(text):
    """True for genuine human prompts; skips slash-command wrappers & injected reminders.

    Tool-result rows carry no text blocks, so extract_text() already returns "" for them
    and they fail the empty check below. We intentionally do NOT reject generic "<...>"
    text, so legitimate markup prompts (e.g. "<svg .../>") are kept.
    """
    if not text:
        return False
    t = text.strip()
    if not t:
        return False
    skip_prefixes = (
        "<local-command",
        "<command-name>",
        "<command-message>",
        "<system-reminder>",
        "<task-notification>",   # harness-injected background-task events, not typed prompts
        "Caveat:",
        "[Request interrupted",
    )
    return not t.startswith(skip_prefixes)


def clean_prompt(text, limit=280):
    """Strip common wrappers/slash-command noise and clamp length."""
    if not text:
        return ""
    t = text.strip()
    if t.startswith("<command-name>"):
        idx = t.rfind(">")
        t = t[idx + 1 :].strip() if idx != -1 else t
    t = t.replace("\r", " ")
    if len(t) > limit:
        t = t[:limit].rstrip() + "…"
    return t


def home_abbrev(path):
    """Display form of a path with the home dir collapsed to '~' (also hides the username)."""
    if not path:
        return path
    home = os.path.expanduser("~")
    if path == home:
        return "~"
    if path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


def scan_session(path):
    """Single-pass parse of one session .jsonl into a metadata dict (or None if unusable)."""
    session_id = os.path.splitext(os.path.basename(path))[0]
    cwd = git_branch = version = entrypoint = None
    custom_title = ai_title = last_prompt = first_prompt = None
    first_ts = last_ts = None
    active_ms = 0
    turn_count = user_msgs = 0
    prompt_list = []
    model_counts = {}
    tok_in = tok_out = tok_cc = tok_cr = web_search = web_fetch = 0

    try:
        fh = open(path, "r", errors="replace")
    except OSError:
        return None

    with fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except (ValueError, TypeError):
                continue
            if not isinstance(d, dict):  # a bare JSON scalar on a line -> skip safely
                continue
            t = d.get("type")

            if cwd is None and d.get("cwd"):
                cwd = d["cwd"]
            if git_branch is None and d.get("gitBranch"):
                git_branch = d["gitBranch"]
            if version is None and d.get("version"):
                version = d["version"]
            if entrypoint is None and d.get("entrypoint"):
                entrypoint = d["entrypoint"]

            ts = parse_ts(d.get("timestamp"))
            if ts is not None:
                if first_ts is None or ts < first_ts:
                    first_ts = ts
                if last_ts is None or ts > last_ts:
                    last_ts = ts

            if t == "custom-title":
                custom_title = d.get("customTitle") or custom_title
            elif t == "ai-title":
                ai_title = d.get("aiTitle") or ai_title
            elif t == "last-prompt":
                last_prompt = d.get("lastPrompt") or last_prompt
            elif t == "system":
                if isinstance(d.get("durationMs"), (int, float)):
                    active_ms += d["durationMs"]
                if d.get("subtype") == "turn_duration":
                    turn_count += 1
            elif t == "assistant":
                amsg = d.get("message")
                if isinstance(amsg, dict):
                    mdl = amsg.get("model")
                    if mdl and mdl != "<synthetic>":
                        model_counts[mdl] = model_counts.get(mdl, 0) + 1
                    u = amsg.get("usage")
                    if isinstance(u, dict):
                        tok_in += u.get("input_tokens") or 0
                        tok_out += u.get("output_tokens") or 0
                        tok_cc += u.get("cache_creation_input_tokens") or 0
                        tok_cr += u.get("cache_read_input_tokens") or 0
                        stu = u.get("server_tool_use")
                        if isinstance(stu, dict):
                            web_search += stu.get("web_search_requests") or 0
                            web_fetch += stu.get("web_fetch_requests") or 0
            elif t == "user":
                user_msgs += 1
                msg = d.get("message")
                images = extract_images(msg)          # inline base64 blocks (the real images)
                body, notes = process_image_annotations(extract_text(msg).strip())
                # A real prompt has typed text, an inline image, or a genuine "not stored"
                # marker. Pure companion-reference rows collapse to empty here and are skipped.
                if looks_like_real_prompt(body) or images or notes:
                    if len(body) > PROMPT_CAP:
                        body = body[:PROMPT_CAP] + "\n\n… [truncated {:,} more characters]".format(
                            len(body) - PROMPT_CAP
                        )
                    entry = {"t": ts.isoformat() if ts else "", "text": body}
                    if images:
                        entry["images"] = images
                    if notes:
                        entry["imageRefs"] = [{"note": n} for n in notes]
                    prompt_list.append(entry)
                    if first_prompt is None and body:
                        first_prompt = body

    if first_ts is None and last_ts is None and not (custom_title or ai_title or last_prompt or first_prompt):
        try:
            mtime = datetime.fromtimestamp(os.path.getmtime(path), tz=timezone.utc)
            first_ts = last_ts = mtime
        except OSError:
            return None

    if not cwd:  # lossy fallback only (encoding maps '/', '_', '-' all to '-')
        enc = os.path.basename(os.path.dirname(path))
        cwd = "/" + enc.lstrip("-").replace("-", "/")

    try:
        size = os.path.getsize(path)
    except OSError:
        size = 0

    resume_name = custom_title or session_id
    resume_cmd = "cd {} && claude --resume {}".format(shlex.quote(cwd), shlex.quote(resume_name))

    span_ms = 0
    if first_ts and last_ts:
        span_ms = int((last_ts - first_ts).total_seconds() * 1000)

    return {
        "id": session_id,
        "cwd": cwd,
        "cwdShort": home_abbrev(cwd),
        "project": os.path.basename(cwd.rstrip("/")) or cwd,
        "gitBranch": git_branch or "",
        "version": version or "",
        "entrypoint": entrypoint or "",
        "customTitle": custom_title or "",
        "aiTitle": ai_title or "",
        "firstPrompt": clean_prompt(first_prompt or ""),
        "promptList": prompt_list,
        "firstTs": first_ts.isoformat() if first_ts else "",
        "lastTs": last_ts.isoformat() if last_ts else "",
        "spanMs": span_ms,
        "activeMs": int(active_ms),
        "prompts": len(prompt_list),
        "userMsgs": user_msgs,
        "models": model_counts,
        "tokIn": tok_in, "tokOut": tok_out, "tokCacheCreate": tok_cc, "tokCacheRead": tok_cr,
        "webSearches": web_search, "webFetches": web_fetch,
        "sizeBytes": size,
        "hasName": bool(custom_title),
        "ambiguous": False,
        "resumeName": resume_name,
        "resumeCmd": resume_cmd,
        "filePath": path,
    }


# Entrypoints for sessions a user actually started interactively. Everything else
# (notably "sdk-cli") is spawned programmatically via the Agent SDK — e.g. batch tools
# that create one throwaway session per item — and is hidden by default.
INTERACTIVE_ENTRYPOINTS = {"cli", "claude-desktop", "vscode", "jetbrains", "web", ""}


def collect(root, include_all=False):
    """Collect metadata for resumable (depth-1) sessions under root.

    Returns (sessions, hidden) where `hidden` is the number of programmatic
    (e.g. sdk-cli) sessions filtered out unless include_all is True.
    """
    scanned = []
    for path in glob.glob(os.path.join(root, "*", "*.jsonl")):
        info = scan_session(path)
        if info is not None:
            scanned.append(info)

    if include_all:
        sessions, hidden = scanned, 0
    else:
        sessions = [s for s in scanned if s["entrypoint"] in INTERACTIVE_ENTRYPOINTS]
        hidden = len(scanned) - len(sessions)

    # Disambiguate: multiple sessions can share the same custom name in one cwd, which
    # makes `claude --resume "<name>"` ambiguous. For those, resume by unique session id.
    groups = defaultdict(list)
    for s in sessions:
        if s["customTitle"]:
            groups[(s["cwd"], s["customTitle"])].append(s)
    for (cwd, _title), grp in groups.items():
        if len(grp) > 1:
            for s in grp:
                s["ambiguous"] = True
                s["resumeName"] = s["id"]
                s["resumeCmd"] = "cd {} && claude --resume {}".format(
                    shlex.quote(cwd), shlex.quote(s["id"])
                )

    sessions.sort(key=lambda s: s["lastTs"], reverse=True)
    return sessions, hidden


def delete_sessions(root, ids_or_names):
    """Delete session .jsonl files by id, custom title, or resume name.

    Returns (deleted_count, not_found).
    """
    sessions, _ = collect(root, include_all=True)
    by_id = {s["id"]: s for s in sessions}
    by_title = {s["customTitle"]: s for s in sessions if s["customTitle"]}
    by_resume = {s["resumeName"]: s for s in sessions}

    deleted = []
    not_found = []
    for token in ids_or_names:
        token = token.strip()
        s = by_id.get(token) or by_title.get(token) or by_resume.get(token)
        if s is None:
            not_found.append(token)
            continue
        path = s.get("filePath")
        if not path or not os.path.isfile(path):
            not_found.append(token)
            continue
        try:
            os.remove(path)
            deleted.append((s.get("customTitle") or s["id"], path))
        except OSError as e:
            not_found.append(f"{token}: {e}")
    return deleted, not_found


def rename_session(root, token, new_name):
    """Rename a session by writing a custom-title row to its .jsonl file.

    Looks up by id, current custom title, or resume name. Returns the session
    info if successful, otherwise None.
    """
    sessions, _ = collect(root, include_all=True)
    by_id = {s["id"]: s for s in sessions}
    by_title = {s["customTitle"]: s for s in sessions if s["customTitle"]}
    by_resume = {s["resumeName"]: s for s in sessions}

    s = by_id.get(token) or by_title.get(token) or by_resume.get(token)
    if s is None:
        return None
    path = s.get("filePath")
    if not path or not os.path.isfile(path):
        return None

    entry = {
        "type": "custom-title",
        "customTitle": new_name,
        "timestamp": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    }
    try:
        # Ensure the file ends in a newline before appending, so the custom-title row can't
        # get glued onto the last line (which would corrupt both and lose the rename).
        need_nl = False
        try:
            if os.path.getsize(path) > 0:
                with open(path, "rb") as rf:
                    rf.seek(-1, os.SEEK_END)
                    need_nl = rf.read(1) != b"\n"
        except OSError:
            need_nl = False
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(("\n" if need_nl else "") + json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError:
        return None
    s["customTitle"] = new_name
    s["hasName"] = True
    return s


