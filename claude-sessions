  if(s.webSearches||s.webFetches){ const b=[]; if(s.webSearches) b.push(`<b>${s.webSearches}</b> web search${s.webSearches===1?'':'es'}`); if(s.webFetches) b.push(`<b>${s.webFetches}</b> fetch${s.webFetches===1?'':'es'}`); parts.push(`<span class="mstat">${b.join(', ')}</span>`); }
