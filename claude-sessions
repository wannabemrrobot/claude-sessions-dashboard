    out = HTML_TEMPLATE
    out = out.replace("__APP_JS__", APP_JS)
    out = out.replace("__API_MODE__", "true" if api_mode else "false")
    out = out.replace("__INCLUDE_ALL__", "true" if include_all else "false")
    out = out.replace("__GENERATED_JSON__", json.dumps(generated_at))
    out = out.replace("__NOTE_JSON__", json.dumps(note))
    for marker, svg in _SHELL_ICONS.items():
        out = out.replace(marker, svg)
    # __DATA__ goes in LAST so arbitrary session text can never clobber a template marker.
    if api_mode:
        data = "null"
    else:
        # Escaping "<" as the JSON unicode escape keeps "</script>" from breaking the island.
        data = json.dumps(sessions, ensure_ascii=False).replace("<", "\\u003c")
    out = out.replace("__DATA__", data)
    return out


