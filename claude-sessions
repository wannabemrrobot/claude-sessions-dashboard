def externalize_images(sessions, assets_dir):
    """Write each prompt's inline base64 images to assets_dir/<sid>/pN-M.ext and rewrite
    each image entry in-place to {src: <relative-url>, media_type}. Returns (count, bytes).

    Files are written once and reused across runs (session data is immutable), so only the
    first run pays the extraction cost.
    """
    n_imgs = n_bytes = 0
    for s in sessions:
        sid = s["id"]
        for pi, p in enumerate(s.get("promptList", [])):
            imgs = p.get("images")
            if not imgs:
                continue
            rewritten = []
            for ii, im in enumerate(imgs):
                ext = _EXT_BY_MEDIA.get((im.get("media_type") or "").lower(), "png")
                sdir = os.path.join(assets_dir, sid)
                fname = "p{}-{}.{}".format(pi, ii, ext)
                fpath = os.path.join(sdir, fname)
                try:
                    if os.path.exists(fpath):
                        n_bytes += os.path.getsize(fpath)
                    else:
                        raw = base64.b64decode(im["data"])
                        os.makedirs(sdir, exist_ok=True)
                        with open(fpath, "wb") as fh:
                            fh.write(raw)
                        n_bytes += len(raw)
                    n_imgs += 1
                    rewritten.append({
                        "src": "{}/{}/{}".format(ASSETS_DIRNAME, sid, fname),
                        "media_type": im.get("media_type", ""),
                    })
                except (ValueError, OSError):
                    continue  # corrupt base64 / unreadable path -> just drop that image
            if rewritten:
                p["images"] = rewritten
            else:
                p.pop("images", None)
    return n_imgs, n_bytes


def _strip_image_data(sessions):
    """For --json: replace heavy base64 with a light descriptor so output stays readable."""
    for s in sessions:
        for p in s.get("promptList", []):
            if p.get("images"):
                p["images"] = [{"media_type": im.get("media_type", ""),
                                "b64len": len(im.get("data", ""))} for im in p["images"]]


