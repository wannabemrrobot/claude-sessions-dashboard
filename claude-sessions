import http.server
import mimetypes
import subprocess
import time
import urllib.parse

# A session is flagged "running" if its .jsonl was written within this many seconds — a
# cheap heuristic for "an agent is actively working in it right now".
ACTIVE_WINDOW_S = 60

_FAVICON = (
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#C96442" '
    'stroke-width="2.4" stroke-linecap="round"><line x1="3" y1="12" x2="21" y2="12"/>'
    '<line x1="12" y1="3" x2="12" y2="21"/><line x1="4.2" y1="7.5" x2="19.8" y2="16.5"/>'
    '<line x1="7.5" y1="4.2" x2="16.5" y2="19.8"/><line x1="16.5" y1="4.2" x2="7.5" y2="19.8"/>'
    '<line x1="19.8" y1="7.5" x2="4.2" y2="16.5"/></svg>'
).encode("utf-8")


def _reveal_in_file_manager(path):
    """Open a directory in the OS file manager. Returns True on success."""
    path = os.path.expanduser(path or "")
    if not path or not os.path.isdir(path):
        return False
    try:
        if sys.platform == "darwin":
            subprocess.Popen(["open", path])
        elif os.name == "nt":
            os.startfile(path)  # type: ignore[attr-defined]
        else:
            subprocess.Popen(["xdg-open", path])
        return True
    except Exception:
        return False


def _api_payload(root, include_all, assets_dir):
    """Fresh rescan of disk -> JSON-serialisable payload for the client."""
    sessions, hidden = collect(root, include_all=include_all)
    externalize_images(sessions, assets_dir)  # writes files, rewrites image entries to {src, media_type}
    for s in sessions:
        s.pop("filePath", None)  # internal only; keep it off the wire
        for p in s.get("promptList", []):
            for im in (p.get("images") or []):
                if isinstance(im, dict) and im.get("src") and not im["src"].startswith("/"):
                    im["src"] = "/" + im["src"]  # server needs absolute URL paths
    generated_at = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
    return {"sessions": sessions, "hidden": hidden, "generatedAt": generated_at}


_TURN_TEXT_CAP = 16000
_TOOL_CAP = 1200


def _cap_text(s, n):
    s = s or ""
    if len(s) <= n:
        return s
    return s[:n] + "\n\n… [truncated {:,} more characters]".format(len(s) - n)


def _flatten_tool_result(rc):
    if isinstance(rc, str):
        return rc
    if isinstance(rc, list):
        out = []
        for b in rc:
            if isinstance(b, dict) and b.get("type") == "text":
                out.append(b.get("text", ""))
            elif isinstance(b, str):
                out.append(b)
        return "\n".join(o for o in out if o)
    return ""


def read_conversation(path):
    """Parse one session .jsonl into an ordered list of turns for the transcript view:
    user / assistant text, plus compact tool_use and tool_result entries. Thinking blocks
    and injected system-reminder / slash-command noise are omitted."""
    turns = []
    try:
        fh = open(path, "r", errors="replace")
    except OSError:
        return turns
    with fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except (ValueError, TypeError):
                continue
            if not isinstance(d, dict):
                continue
            typ = d.get("type")
            ts = d.get("timestamp", "") or ""
            msg = d.get("message")
            if typ == "user":
                content = msg.get("content") if isinstance(msg, dict) else msg
                images = extract_images(msg) if isinstance(msg, dict) else []
                if isinstance(content, str):
                    txt, _ = process_image_annotations(content.strip())
                    if txt and looks_like_real_prompt(txt):
                        turns.append({"role": "user", "text": _cap_text(txt, _TURN_TEXT_CAP), "t": ts})
                elif isinstance(content, list):
                    parts = []
                    for b in content:
                        if isinstance(b, str):
                            parts.append(b)
                        elif isinstance(b, dict):
                            bt = b.get("type")
                            if bt == "text":
                                parts.append(b.get("text", ""))
                            elif bt == "tool_result":
                                rt = _flatten_tool_result(b.get("content"))
                                turns.append({"role": "tool_result", "text": _cap_text(rt, _TOOL_CAP),
                                              "t": ts, "isError": bool(b.get("is_error"))})
                    txt, _ = process_image_annotations("\n".join(p for p in parts if p).strip())
                    realtext = txt if (txt and looks_like_real_prompt(txt)) else ""
                    if realtext or images:
                        turn = {"role": "user", "t": ts}
                        if realtext:
                            turn["text"] = _cap_text(realtext, _TURN_TEXT_CAP)
                        if images:
                            turn["images"] = images   # [{media_type, data(base64)}] -> externalized by the handler
                        turns.append(turn)
            elif typ == "assistant":
                content = msg.get("content") if isinstance(msg, dict) else None
                mdl = msg.get("model") if isinstance(msg, dict) else None
                if mdl == "<synthetic>":
                    mdl = None
                if isinstance(content, str):
                    tx = content.strip()
                    if tx:
                        turns.append({"role": "assistant", "text": _cap_text(tx, _TURN_TEXT_CAP), "t": ts, "model": mdl})
                elif isinstance(content, list):
                    for b in content:
                        if not isinstance(b, dict):
                            continue
                        bt = b.get("type")
                        if bt == "text":
                            tx = (b.get("text") or "").strip()
                            if tx:
                                turns.append({"role": "assistant", "text": _cap_text(tx, _TURN_TEXT_CAP), "t": ts, "model": mdl})
                        elif bt == "tool_use":
                            inp = b.get("input")
                            inps = inp if isinstance(inp, str) else json.dumps(inp, ensure_ascii=False, indent=2)
                            turns.append({"role": "tool_use", "tool": b.get("name", "tool"),
                                          "input": _cap_text(inps or "", _TOOL_CAP), "t": ts})
                        # thinking blocks intentionally omitted
    return turns


def _externalize_conv_images(sid, turns, assets_dir):
    """Write transcript turn images (base64) to the assets dir and rewrite each to {src, media_type}
    served via /claude-sessions-assets/. Mirrors externalize_images for the conversation view."""
    for ti, t in enumerate(turns):
        imgs = t.get("images")
        if not imgs:
            continue
        rewritten = []
        for ii, im in enumerate(imgs):
            ext = _EXT_BY_MEDIA.get((im.get("media_type") or "").lower(), "png")
            sdir = os.path.join(assets_dir, sid)
            fname = "conv-{}-{}.{}".format(ti, ii, ext)
            fpath = os.path.join(sdir, fname)
            try:
                if not os.path.exists(fpath):
                    raw = base64.b64decode(im["data"])
                    os.makedirs(sdir, exist_ok=True)
                    with open(fpath, "wb") as fh:
                        fh.write(raw)
                rewritten.append({"src": "/{}/{}/{}".format(ASSETS_DIRNAME, sid, fname),
                                  "media_type": im.get("media_type", "")})
            except (ValueError, OSError):
                continue
        if rewritten:
            t["images"] = rewritten
        else:
            t.pop("images", None)


class _Handler(http.server.BaseHTTPRequestHandler):
    server_version = "ClaudeSessions/2.0"

    # --- helpers ---
    def log_message(self, *a):  # keep the console quiet
        pass

    def _cfg(self):
        return self.server.cfg

    def _guard_host(self):
        # Only accept loopback Host headers (blocks DNS-rebinding from a browsing site).
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
        if host in ("127.0.0.1", "localhost", "::1", ""):
            return True
        self._send(403, b"forbidden", "text/plain")
        return False

    def _send(self, code, body, ctype, extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        if extra:
            for k, v in extra.items():
                self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            try:
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj, ensure_ascii=False), "application/json; charset=utf-8")

    def _read_json(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except (TypeError, ValueError):
            n = 0
        raw = self.rfile.read(n) if n > 0 else b""
        if not raw:
            return {}
        try:
            return json.loads(raw.decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return None

    # --- routes ---
    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        if not self._guard_host():
            return
        cfg = self._cfg()
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        if path in ("/", "/index.html"):
            self._send(200, cfg["html"], "text/html; charset=utf-8")
            return
        if path == "/api/sessions":
            qs = urllib.parse.parse_qs(parsed.query)
            all_q = qs.get("all", [""])[0]
            include_all = cfg["include_all"] or (all_q not in ("", "0", "false"))
            try:
                self._json(_api_payload(cfg["root"], include_all, cfg["assets_dir"]))
            except Exception as e:  # never crash the handler thread
                self._json({"error": str(e)}, 500)
            return
        if path == "/api/active":
            now = time.time()
            ids = []
            for p in glob.glob(os.path.join(cfg["root"], "*", "*.jsonl")):
                try:
                    if now - os.path.getmtime(p) <= ACTIVE_WINDOW_S:
                        ids.append(os.path.splitext(os.path.basename(p))[0])
                except OSError:
                    continue
            self._json({"active": ids, "windowS": ACTIVE_WINDOW_S})
            return
        if path == "/api/conversation":
            sid = urllib.parse.parse_qs(parsed.query).get("id", [""])[0].strip()
            if not re.match(r"^[A-Za-z0-9._-]+$", sid):  # guards against path traversal
                self._json({"error": "invalid id"}, 400)
                return
            matches = glob.glob(os.path.join(cfg["root"], "*", sid + ".jsonl"))
            if not matches:
                self._json({"error": "session not found"}, 404)
                return
            try:
                turns = read_conversation(matches[0])
                _externalize_conv_images(sid, turns, cfg["assets_dir"])
                self._json({"id": sid, "turns": turns})
            except Exception as e:
                self._json({"error": str(e)}, 500)
            return
        if path == "/favicon.ico":
            self._send(200, _FAVICON, "image/svg+xml")
            return
        if path.startswith("/" + ASSETS_DIRNAME + "/"):
            self._serve_asset(cfg["assets_dir"], path)
            return
        self._send(404, b"not found", "text/plain")

    def do_POST(self):
        if not self._guard_host():
            return
        # Require a JSON content-type: browsers force a CORS preflight for cross-site JSON
        # POSTs (which we don't answer), and HTML forms can't set it — a simple CSRF guard.
        if "application/json" not in (self.headers.get("Content-Type") or ""):
            self._json({"error": "content-type must be application/json"}, 415)
            return
        cfg = self._cfg()
        path = urllib.parse.urlparse(self.path).path
        body = self._read_json()
        if body is None or not isinstance(body, dict):
            self._json({"error": "invalid JSON body"}, 400)
            return
        try:
            if path == "/api/rename":
                sid = (body.get("id") or body.get("token") or "").strip()
                name = (body.get("name") or "").strip()
                if not sid or not name:
                    self._json({"error": "id and name are required"}, 400)
                    return
                if rename_session(cfg["root"], sid, name) is None:
                    self._json({"error": "session not found"}, 404)
                    return
                self._json(_api_payload(cfg["root"], cfg["include_all"], cfg["assets_dir"]))
                return
            if path == "/api/delete":
                ids = body.get("ids") or ([body["id"]] if body.get("id") else [])
                ids = [str(x).strip() for x in ids if str(x).strip()]
                if not ids:
                    self._json({"error": "ids are required"}, 400)
                    return
                # never delete a session an agent is actively writing to (mtime within window)
                now = time.time()
                active_ids = set()
                for p in glob.glob(os.path.join(cfg["root"], "*", "*.jsonl")):
                    try:
                        if now - os.path.getmtime(p) <= ACTIVE_WINDOW_S:
                            active_ids.add(os.path.splitext(os.path.basename(p))[0])
                    except OSError:
                        continue
                refused = [i for i in ids if i in active_ids]
                deletable = [i for i in ids if i not in active_ids]
                deleted, not_found = delete_sessions(cfg["root"], deletable) if deletable else ([], [])
                payload = _api_payload(cfg["root"], cfg["include_all"], cfg["assets_dir"])
                payload["deleted"] = [name for name, _ in deleted]
                payload["notFound"] = not_found
                payload["refused"] = refused
                self._json(payload)
                return
            if path == "/api/reveal":
                ok = _reveal_in_file_manager(body.get("cwd"))
                self._json({"ok": ok} if ok else {"error": "could not open folder"}, 200 if ok else 400)
                return
        except Exception as e:
            self._json({"error": str(e)}, 500)
            return
        self._json({"error": "unknown endpoint"}, 404)

    def _serve_asset(self, assets_dir, path):
        rel = urllib.parse.unquote(path[len("/" + ASSETS_DIRNAME + "/"):])
        base = os.path.realpath(assets_dir)
        target = os.path.realpath(os.path.join(base, rel))
        if not (target == base or target.startswith(base + os.sep)) or not os.path.isfile(target):
            self._send(404, b"not found", "text/plain")
            return
        ctype = mimetypes.guess_type(target)[0] or "application/octet-stream"
        try:
            with open(target, "rb") as fh:
                data = fh.read()
        except OSError:
            self._send(404, b"not found", "text/plain")
            return
        self._send(200, data, ctype)


class _Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def serve(root, include_all=False, port=0, open_browser=True):
    """Run the live dashboard on localhost until interrupted."""
    assets_dir = os.path.join(os.path.dirname(os.path.abspath(root)), ASSETS_DIRNAME)
    try:
        os.makedirs(assets_dir, exist_ok=True)
    except OSError:
        pass

    # The shell HTML is data-less; the client fetches /api/sessions on load and on Refresh.
    html_shell = build_html([], "", note="", api_mode=True, include_all=include_all).encode("utf-8")

    candidates = [port] if port else [7842, 7843, 7860, 8420, 0]
    httpd = None
    for p in candidates:
        try:
            httpd = _Server(("127.0.0.1", p), _Handler)
            break
        except OSError:
            httpd = None
    if httpd is None:
        print("error: could not bind a local port (try --port N)", file=sys.stderr)
        return 2

    httpd.cfg = {
        "root": root,
        "include_all": include_all,
        "assets_dir": assets_dir,
        "html": html_shell,
    }
    actual_port = httpd.server_address[1]
    url = f"http://127.0.0.1:{actual_port}/"

    try:
        sessions, hidden = collect(root, include_all=include_all)
        n = len(sessions)
    except Exception:
        n, hidden = 0, 0

    print("claude-sessions — live dashboard")
    print(f"  serving   {url}")
    print(f"  scanning  {root}")
    print(f"  {n} session(s)" + (f"  ·  {hidden} SDK/agent hidden (toggle in the UI)" if hidden else ""))
    print("  Refresh / Rename / Delete are one-click.  Press Ctrl+C to stop.")
    sys.stdout.flush()  # show the URL immediately even when stdout is piped/redirected
    if open_browser:
        try:
            webbrowser.open(url)
        except Exception:
            pass
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n  stopped.")
    finally:
        httpd.server_close()
    return 0


# --------------------------------------------------------------------------- #
# Demo mode — serve fictional sessions (NEVER reads or touches ~/.claude/projects)
# --------------------------------------------------------------------------- #
_DEMO_B64 = ""   # base64 of a JSON list of fictional session specs (filled at build time)


def _demo_projects_dir():
    return os.path.join(os.path.expanduser("~/.claude"), "claude-sessions-demo", "projects")


def _materialize_demo(projects_dir):
    """Write the embedded fictional sessions to <projects_dir>/demo/*.jsonl and return the path of
    the single 'running' session (mtime kept fresh), or None. Isolated from ~/.claude/projects."""
    specs = json.loads(base64.b64decode(_DEMO_B64))
    demo = os.path.join(projects_dir, "demo")
    shutil.rmtree(projects_dir, ignore_errors=True)
    os.makedirs(demo, exist_ok=True)
    now = datetime.now(timezone.utc)
    ver = "2.0.14"
    running_path = None
    for s in specs:
        turns = s.get("turns", [])
        n = max(1, len(turns))
        age = s.get("ageDays", 0)
        active = s.get("activeMinutes", 20)
        start = now - timedelta(days=age, minutes=active)
        models = s.get("models") or ["claude-opus-4-8"]

        def model_at(idx):
            return models[1] if len(models) > 1 and idx >= n // 2 else models[0]

        rows = []
        tok_in = 1500
        tool_n = 0
        for i, t in enumerate(turns):
            ts = (start + timedelta(seconds=int(active * 60 * (i / max(1, n - 1))))).isoformat().replace("+00:00", "Z")
            role = t.get("role")
            if role == "user":
                if t.get("imageB64"):
                    content = []
                    if t.get("text"):
                        content.append({"type": "text", "text": t["text"]})
                    content.append({"type": "image", "source": {"type": "base64",
                        "media_type": t.get("imageType", "image/png"), "data": t["imageB64"]}})
                else:
                    content = t.get("text", "")
                row = {"type": "user", "timestamp": ts, "version": ver,
                       "message": {"role": "user", "content": content}}
                if i == 0:
                    row["cwd"] = s["cwd"]; row["gitBranch"] = s["branch"]
                rows.append(row)
            elif role == "assistant":
                tok_in += 400
                rows.append({"type": "assistant", "timestamp": ts, "version": ver,
                    "message": {"role": "assistant", "model": model_at(i),
                        "content": [{"type": "text", "text": t.get("text", "")}],
                        "usage": {"input_tokens": tok_in, "output_tokens": max(90, len(t.get("text", "")) // 3),
                                  "cache_creation_input_tokens": 600, "cache_read_input_tokens": 18000 + i * 14000,
                                  "server_tool_use": {"web_search_requests": 0, "web_fetch_requests": 0}}}})
            elif role == "tool_use":
                tool_n += 1
                is_web = t.get("tool") == "WebSearch"
                rows.append({"type": "assistant", "timestamp": ts, "version": ver,
                    "message": {"role": "assistant", "model": model_at(i),
                        "content": [{"type": "tool_use", "id": "t%d" % tool_n, "name": t.get("tool", "Tool"),
                                     "input": t.get("input", "")}],
                        "usage": {"input_tokens": tok_in, "output_tokens": 40,
                                  "cache_creation_input_tokens": 300, "cache_read_input_tokens": 18000 + i * 14000,
                                  "server_tool_use": {"web_search_requests": 1 if is_web else 0, "web_fetch_requests": 0}}}})
            elif role == "tool_result":
                rows.append({"type": "user", "timestamp": ts, "version": ver,
                    "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "t%d" % tool_n,
                        "content": t.get("text", ""), "is_error": bool(t.get("isError"))}]}})

        if s.get("title"):
            rows.append({"type": "custom-title", "customTitle": s["title"],
                         "timestamp": (now - timedelta(days=age)).isoformat().replace("+00:00", "Z")})

        a_turns = max(1, sum(1 for t in turns if t.get("role") == "assistant"))
        chunk = int(active * 60 * 1000 / a_turns)
        for k in range(a_turns):
            rows.append({"type": "system", "subtype": "turn_duration", "durationMs": chunk,
                         "timestamp": (start + timedelta(minutes=k)).isoformat().replace("+00:00", "Z")})

        path = os.path.join(demo, "%s.jsonl" % s["id"])
        with open(path, "w", encoding="utf-8") as fh:
            fh.write("\n".join(json.dumps(r, ensure_ascii=False) for r in rows) + "\n")
        if s.get("running"):
            running_path = path                    # leave mtime ~now -> shows as running
        else:
            # backdate past the active window so non-running sessions never show as live, even
            # today's (their "just now" comes from the JSONL timestamps, not the file mtime)
            mt = now.timestamp() - max(age * 86400, 300)
            os.utime(path, (mt, mt))
    return running_path


def _start_demo_keepalive(path):
    """Keep the demo's 'running' session fresh so the live indicator stays visible while demoing."""
    if not path:
        return
    def _tick():
        while True:
            try:
                os.utime(path, None)
            except OSError:
                pass
            time.sleep(25)
    threading.Thread(target=_tick, daemon=True).start()


def main(argv=None):
    ap = argparse.ArgumentParser(description="Live dashboard of all your Claude Code sessions.")
    ap.add_argument("--root", default=DEFAULT_ROOT, help="Path to ~/.claude/projects")
    ap.add_argument("--all", action="store_true",
                    help="Include programmatic (sdk-cli / agent-spawned) sessions, not just ones you started")
    ap.add_argument("--demo", action="store_true",
                    help="Serve a set of fictional demo sessions (never reads or touches your real ~/.claude/projects)")
    ap.add_argument("--port", type=int, default=0, help="(server mode) Preferred localhost port; auto-falls back")
    ap.add_argument("--no-open", dest="open", action="store_false",
                    help="Do not open the browser automatically")
    ap.add_argument("--static", action="store_true",
                    help="Write a self-contained, portable static HTML file instead of serving live")
    ap.add_argument("--out", default=None, help="(static mode) Output HTML path (default: ~/.claude/claude-sessions.html)")
    ap.add_argument("--json", action="store_true", help="Print the raw session metadata as JSON and exit")
    ap.add_argument("--delete", nargs="+", metavar="ID_OR_NAME",
                    help="Delete one or more sessions by id, custom title, or resume name")
    ap.add_argument("--rename", nargs=2, metavar=("ID_OR_NAME", "NEW_NAME"),
                    help="Rename a session by id, current custom title, or resume name")
    ap.set_defaults(open=True)
    args = ap.parse_args(argv)

    root = os.path.expanduser(args.root)
    if args.demo:
        root = _demo_projects_dir()
        _start_demo_keepalive(_materialize_demo(root))
        print("demo mode — serving fictional sessions; your real ~/.claude/projects is untouched")
    if not os.path.isdir(root):
        print(f"error: projects dir not found: {root}", file=sys.stderr)
        return 2

    if args.delete:
        deleted, not_found = delete_sessions(root, args.delete)
        for name, path in deleted:
            print(f"deleted: {name}  ({path})")
        if not_found:
            print(f"error: could not find/delete: {', '.join(not_found)}", file=sys.stderr)
        return 2 if not_found and not deleted else 0

    if args.rename:
        token, new_name = args.rename
        s = rename_session(root, token, new_name)
        if s is None:
            print(f"error: could not rename session: {token}", file=sys.stderr)
            return 2
        print(f"renamed: {s['id']} -> {new_name}")
        return 0

    if args.json:
        sessions, _ = collect(root, include_all=args.all)
        _strip_image_data(sessions)
        print(json.dumps(sessions, indent=2, ensure_ascii=False))
        return 0

    if args.static:
        sessions, hidden = collect(root, include_all=args.all)
        generated_at = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
        default_out = os.path.join(os.path.dirname(os.path.abspath(root)), "claude-sessions.html")
        out_path = os.path.expanduser(args.out or default_out)
        assets_dir = os.path.join(os.path.dirname(os.path.abspath(out_path)), ASSETS_DIRNAME)
        n_imgs, n_bytes = externalize_images(sessions, assets_dir)
        note = f"{hidden} SDK/agent sessions hidden (use --all)" if hidden else ""
        with open(out_path, "w", encoding="utf-8") as fh:
            fh.write(build_html(sessions, generated_at, note, api_mode=False, include_all=args.all))
        named = sum(1 for s in sessions if s["hasName"])
        print(f"Wrote {out_path}")
        print(f"  {len(sessions)} sessions  ({named} named, {len(sessions) - named} unnamed)"
              + (f"  ·  {hidden} SDK/agent hidden (use --all)" if hidden else ""))
        if n_imgs:
            print(f"  {n_imgs} pasted images extracted to {assets_dir} ({n_bytes / 1024 / 1024:.1f} MB)")
        if args.open:
            webbrowser.open(pathlib.Path(out_path).resolve().as_uri())
            print("  opened in browser")
        else:
            print(f"  open it with:  open {shlex.quote(out_path)}")
        return 0

    # default: live server
    return serve(root, include_all=args.all, port=args.port, open_browser=args.open)


if __name__ == "__main__":
    raise SystemExit(main())
