(function(){
  const el=$('#tooltip'); if(!el) return;
  let cur=null;
  function place(t){
    const r=t.getBoundingClientRect(), tw=el.offsetWidth, th=el.offsetHeight;
    let left=r.left + r.width/2 - tw/2;
    let top=r.top - th - 6;                       // prefer above
    if(top < 6) top = r.bottom + 6;               // flip below if no room
    left=Math.max(8, Math.min(left, window.innerWidth - tw - 8));
    el.style.left=left+'px'; el.style.top=top+'px';
  }
  function show(t){
    const txt=t.getAttribute('data-tip'); if(!txt){ hide(); return; }
    el.textContent=txt; el.setAttribute('aria-hidden','false'); el.classList.add('show'); place(t); cur=t;
  }
  function hide(){ if(!cur){ return; } el.classList.remove('show'); el.setAttribute('aria-hidden','true'); cur=null; }
  document.addEventListener('mouseover', e=>{ const t=e.target.closest?e.target.closest('[data-tip]'):null; if(t){ if(t!==cur) show(t); } else if(cur) hide(); });
  document.addEventListener('mouseout', e=>{ const t=e.target.closest?e.target.closest('[data-tip]'):null; if(t && (!e.relatedTarget || !t.contains(e.relatedTarget))) hide(); });
  document.addEventListener('focusin', e=>{ const t=e.target.closest?e.target.closest('[data-tip]'):null; if(t) show(t); });
  document.addEventListener('focusout', hide);
  window.addEventListener('scroll', hide, true);
  window.addEventListener('resize', hide);
})();

