async function apiGet(p){ const r=await fetch(p,{cache:'no-store'}); if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); }
async function apiPost(p,body){
  const r=await fetch(p,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  if(!r.ok){ let m='HTTP '+r.status; try{ const j=await r.json(); if(j.error)m=j.error; }catch(e){} throw new Error(m); }
  return r.json();
}
