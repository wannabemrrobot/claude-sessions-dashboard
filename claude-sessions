async function pollActive(){
  if(!API_MODE || DELETING) return;   // don't re-render mid-delete: it would wipe the busy overlay
  try{
    const j=await apiGet('/api/active');
    const next=new Set(j.active||[]);
    let changed = next.size!==ACTIVE.size;
    if(!changed){ for(const id of next){ if(!ACTIVE.has(id)){ changed=true; break; } } }
    ACTIVE=next;
    if(changed) render(); else applyActive();   // re-render on change → running float to top + counter updates
  }catch(e){}
}

