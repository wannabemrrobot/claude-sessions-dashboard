/* ---- formatting helpers ---- */
function esc(s){
  return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function fmtDur(ms){
  if(!ms || ms<0) return "—";
  const s=Math.round(ms/1000);
  if(s<60) return s+"s";
  const m=Math.round(s/60); if(m<60) return m+"m";
  const h=Math.floor(m/60), rm=m%60; if(h<24) return rm?`${h}h ${rm}m`:`${h}h`;
  const d=Math.floor(h/24), rh=h%24; return rh?`${d}d ${rh}h`:`${d}d`;
}
function relTime(iso){
  if(!iso) return {label:"unknown", days:null};
  const then=new Date(iso), now=new Date();
  let diff=now-then; if(diff<0) diff=0;
  const day=86400000, days=Math.floor(diff/day);
  let label;
  if(diff<60000) label="just now";
  else if(diff<3600000) label=Math.round(diff/60000)+"m ago";
  else if(diff<day) label=Math.round(diff/3600000)+"h ago";
  else if(days===1) label="yesterday";
  else if(days<30) label=days+" days ago";
  else if(days<365) label=Math.round(days/30)+" mo ago";
  else label=Math.round(days/365)+" yr ago";
  return {label, days};
}
function fmtDate(iso){ if(!iso) return ""; try{ return new Date(iso).toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'}); }catch(e){ return iso; } }
function absTime(iso){ if(!iso) return ""; try{ return new Date(iso).toLocaleString(); }catch(e){ return iso; } }
function fmtWhen(iso){ if(!iso) return ""; try{ return new Date(iso).toLocaleString(undefined,{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'}); }catch(e){ return iso; } }
function titleOf(s){ if(s.customTitle) return s.customTitle; if(s.aiTitle) return s.aiTitle; if(s.firstPrompt) return s.firstPrompt.slice(0,90); return "(untitled session)"; }
function computeHay(s){
  return (s.customTitle+" "+s.aiTitle+" "+s.firstPrompt+" "+s.cwd+" "+s.gitBranch+" "+s.id+" "
    +(s.promptList||[]).map(p=>p.text).join(" ")).toLowerCase();
}
/* "claude-opus-4-8" -> "Opus 4.8"; strips a trailing date suffix */
function modelName(id){
  if(!id) return "";
  let m=String(id).replace(/^claude-/,'').replace(/-\d{6,}$/,'');
  const parts=m.split('-'); const fam=parts.shift()||m;
  return (fam.charAt(0).toUpperCase()+fam.slice(1)+(parts.length?' '+parts.join('.'):'')).trim();
}
function fmtTok(n){ n=n||0; if(n<1000) return ''+n; if(n<1e6){ const k=n/1000; return (k<10?k.toFixed(1):Math.round(k))+'k'; } const mm=n/1e6; return (mm<10?mm.toFixed(2):mm.toFixed(1))+'M'; }
function modelList(s){ return Object.entries(s.models||{}).sort((a,b)=>b[1]-a[1]); }

/* Optional cost estimate. USD per 1M tokens, keyed by model-family prefix. These are
   EXAMPLES — verify against current pricing and edit; leave empty to hide the $ figure.
   Meaningless on a Claude subscription (Max/Pro), where usage isn't billed per token. */
const SHOW_COST = true;
const PRICING = {   // familyPrefix: {inputPerM, outputPerM}
  'claude-opus':   {in:15, out:75},
  'claude-sonnet': {in:3,  out:15},
  'claude-haiku':  {in:0.8,out:4},
  // 'claude-fable': {in:?, out:?},   // add rates to include Fable in the estimate
};
function priceFor(id){ for(const k in PRICING){ if(String(id).startsWith(k)) return PRICING[k]; } return null; }
/* returns {usd, partial} using per-model turn share of tokens (approx), or null if unpriced */
function estCost(s){
  const models=modelList(s); if(!models.length || !(s.tokIn||s.tokOut)) return null;
  const totalTurns=models.reduce((a,[,c])=>a+c,0)||1;
  let usd=0, priced=0, unpriced=0;
  for(const [id,c] of models){
    const p=priceFor(id); const share=c/totalTurns;
    if(p){ usd += (s.tokIn*share/1e6)*p.in + (s.tokOut*share/1e6)*p.out; priced++; }
    else unpriced++;
  }
  if(!priced) return null;
  return {usd, partial: unpriced>0};
}

